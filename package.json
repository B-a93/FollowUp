{
  "name": "followup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --workspace server run dev",
    "build:client": "tsc -b && vite build",
    "build:server": "npm --workspace server run build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "migrate": "npm --workspace server run migrate:prod",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  },
  "devDependencies": {},
  "workspaces": [
    "server"
  ],
  "main": "dist/index.js"
}
